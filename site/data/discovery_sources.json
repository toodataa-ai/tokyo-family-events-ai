    ],
    "allowed_purposes": [
      "candidate_discovery",
      "official_verification",
      "both"
    ],
    "note": "新規参照元は explicit_sources に追記する。既存idは変更・削除せず、停止時は enabled=false と理由noteを残す。"
  },
