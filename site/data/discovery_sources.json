{
  "schema_version": 3,
  "updated_at": "2026-10-10",
  "principle": "候補発見はAI横断探索と明示参照元探索を両方実行する。媒体は候補発見用、公式・主催者情報は掲載確定用。",
  "discovery_strategy": {
    "ai_cross_search": {
      "enabled": true,
      "per_ward_required": true,
      "scope": "東京23区を1区ずつ独立探索",
      "layers": [
        "各区公式イベント・観光・子育て・文化・公園・図書館・児童館",
        "東京都・都立施設・公的施設",
        "主催者・会場・施設・商業施設・鉄道・交通・スポーツ・劇場・大学の公式",
        "公式観光協会",
        "子育て・地域イベント媒体",
        "Web横断検索"
      ],
      "query_dimensions": [
        "子ども/子供/親子",
        "イベント",
        "祭り/フェス",
        "ワークショップ/体験",
        "無料",
        "スタンプラリー",
        "鉄道/電車",
        "動物",
        "科学",
        "防災/消防"
      ],
      "record_to": "ai_discovery_summary"
    },
    "explicit_sources": {
      "enabled": true,
      "required_each_run": true,
      "use_search_urls_if_present": true,
      "record_each_check": true,
      "allow_future_additions": true,
      "record_to": "explicit_source_checks",
      "rule": "enabled=true の明示参照元を確認する。required=true は必須、required=false はbest effort。search_urlsがある場合はbase_urlだけの確認で代替しない。"
    }
  },
  "protected_legacy_source_ids": [
    "sumida",
    "asakusa",
    "ueno",
    "akihabara",
    "hibiya",
    "ikebukuro",
    "shinjuku",
